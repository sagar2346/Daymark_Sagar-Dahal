<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DailyJournalApp.ViewModels"
             x:Class="DailyJournalApp.Views.LoginPage"
             Shell.FlyoutItemIsVisible="False"
             Shell.NavBarIsVisible="False"
             x:DataType="vm:LoginViewModel"
             Background="{StaticResource DeepSpace}">

    <Shell.FlyoutBehavior>Disabled</Shell.FlyoutBehavior>

    <Grid BackgroundColor="{StaticResource DeepSpace}">
        <!-- Main Card -->
        <Border VerticalOptions="Center" 
                HorizontalOptions="Center" 
                WidthRequest="420"
                Style="{StaticResource GlassCard}"
                Padding="40">
            <VerticalStackLayout Spacing="30">
                <!-- Branding/Welcome -->
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="Welcome Back" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="White" 
                           HorizontalOptions="Center" />
                    <Label Text="Sign in to continue your journey" 
                           FontSize="14" 
                           TextColor="{StaticResource Neutral400}" 
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Form Fields -->
                <VerticalStackLayout Spacing="20">
                    <!-- Name Field (Matching design, allows display or entry) -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Name" FontSize="12" TextColor="{StaticResource Neutral400}" Margin="5,0"/>
                        <Border StrokeShape="RoundRectangle 12" 
                                BackgroundColor="#1E293B" 
                                StrokeThickness="0" 
                                HeightRequest="56"
                                Padding="15,0">
                            <Entry Text="{Binding UserName}" 
                                   TextColor="White" 
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password Field -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Password" FontSize="12" TextColor="{StaticResource Neutral400}" Margin="5,0"/>
                        <Border StrokeShape="RoundRectangle 12" 
                                BackgroundColor="#1E293B" 
                                StrokeThickness="0" 
                                HeightRequest="56"
                                Padding="15,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry Placeholder="Enter password" 
                                       IsPassword="True"
                                       Text="{Binding Password}"
                                       VerticalOptions="Center"
                                       TextColor="White"
                                       PlaceholderColor="{StaticResource Neutral500}"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                    
                    <Label Text="{Binding ErrorMessage}" 
                           TextColor="{StaticResource Danger}" 
                           FontSize="12" 
                           IsVisible="{Binding HasError}" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Login Button -->
                <Button Text="Login" 
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButton}"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="56"
                        FontSize="16"
                        FontAttributes="Bold"
                        IsEnabled="{Binding IsNotBusy}"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
