<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DailyJournalApp.ViewModels"
             x:Class="DailyJournalApp.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Title}">
    
    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral950}}">
        <Border VerticalOptions="Center" 
                HorizontalOptions="Center" 
                WidthRequest="450" 
                Padding="40"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Offset="0,10" Radius="30" Opacity="0.1"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="30">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="Welcome Back" 
                           Style="{StaticResource Headline}" 
                           HorizontalOptions="Center"/>
                    <Label Text="Sign in to continue your journey" 
                           TextColor="{StaticResource Neutral500}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="20">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Name" 
                               FontSize="12" 
                               TextColor="{StaticResource Neutral600}"
                               Margin="5,0"/>
                        <Entry Text="{Binding Username}"
                               Placeholder="Enter your name"
                               FontSize="16"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Password" 
                               FontSize="12" 
                               TextColor="{StaticResource Neutral600}"
                               Margin="5,0"/>
                        <Grid>
                            <Entry Text="{Binding Password}"
                                   IsPassword="{Binding IsPasswordHidden}"
                                   Placeholder="Enter password"
                                   FontSize="16"/>
                            <ImageButton Source="{Binding IsPasswordHidden, Converter={StaticResource PasswordIconConverter}}"
                                         Command="{Binding TogglePasswordVisibilityCommand}"
                                         HorizontalOptions="End"
                                         VerticalOptions="Center"
                                         Margin="0,0,10,0"
                                         WidthRequest="24"
                                         HeightRequest="24"
                                         BackgroundColor="Transparent"/>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Danger}"
                       HorizontalOptions="Center"
                       HeightRequest="20"/>

                <Button Text="Login"
                        Command="{Binding LoginCommand}"
                        FontAttributes="Bold"
                        HeightRequest="50"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
