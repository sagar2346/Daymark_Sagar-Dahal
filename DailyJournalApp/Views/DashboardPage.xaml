<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DailyJournalApp.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="DailyJournalApp.Views.DashboardPage"
             Title="{Binding Title}"
             x:Name="this"
             x:DataType="vm:DashboardViewModel">
    <ScrollView>
        <VerticalStackLayout Spacing="30" Padding="30">
            <!-- Header Section -->
            <VerticalStackLayout Spacing="5">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{Binding UserName, StringFormat='Welcome, {0}'}" Style="{StaticResource Headline}" />
                        <Label Text="Ready for today's reflection?" Style="{StaticResource SubHeadline}" />
                    </VerticalStackLayout>
                </Grid>


            </VerticalStackLayout>
            
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="20" RowSpacing="20">
                <!-- Streak Card -->
                <Border Grid.Row="0" Grid.Column="0" Padding="25" BackgroundColor="{StaticResource Primary}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Label Text="CURRENT STREAK" 
                               TextColor="{StaticResource White}" 
                               FontSize="11" 
                               FontAttributes="Bold" 
                               CharacterSpacing="1"
                               HorizontalOptions="Center" 
                               Opacity="0.8"/>
                        <Label Text="{Binding CurrentStreak}" 
                               TextColor="{StaticResource White}" 
                               FontSize="48" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" />
                        <Label Text="DAYS" 
                               TextColor="{StaticResource White}" 
                               FontSize="12" 
                               HorizontalOptions="Center" 
                               Opacity="0.8"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Total Entries Card -->
                <Border Grid.Row="0" Grid.Column="1" Padding="25">
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Label Text="TOTAL ENTRIES" 
                               TextColor="{StaticResource Neutral500}" 
                               FontSize="11" 
                               FontAttributes="Bold" 
                               CharacterSpacing="1"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding TotalEntries}" 
                               Style="{StaticResource Headline}"
                               FontSize="48"
                               HorizontalOptions="Center" />
                        <Label Text="RECORDS" 
                               TextColor="{StaticResource Neutral500}" 
                               FontSize="12" 
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Mood Analytics Card -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="25">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="25">
                        <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                            <Label Text="DOMINANT MOOD" 
                                   TextColor="{StaticResource Neutral500}" 
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   CharacterSpacing="1"/>
                            <Label Text="{Binding MostFrequentMood}" 
                                   TextColor="{StaticResource Secondary}" 
                                   FontSize="28" 
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                        
                        <BoxView Grid.Column="1" HeightRequest="1" Color="{StaticResource Neutral200}" VerticalOptions="Center" Margin="0,0,20,0"/>
                    </Grid>
                </Border>
            </Grid>

            <VerticalStackLayout Spacing="15">
                <Label Text="Weekly Activity" Style="{StaticResource SubHeadline}" />
                <Border HeightRequest="300" Padding="20">
                    <lvc:CartesianChart Series="{Binding WeeklySeries}" 
                                       XAxes="{Binding XAxes}"
                                       VerticalOptions="Fill" />
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
