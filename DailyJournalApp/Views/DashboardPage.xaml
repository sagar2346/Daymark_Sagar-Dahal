<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DailyJournalApp.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:model="clr-namespace:DailyJournalApp.Models"
             x:Class="DailyJournalApp.Views.DashboardPage"
             Title="{Binding Title}"
             x:Name="this"
             x:DataType="vm:DashboardViewModel">
    <ScrollView Background="{StaticResource DeepSpace}">
        <VerticalStackLayout Spacing="30" Padding="30">
            <!-- Header Section -->
            <VerticalStackLayout Spacing="5">
                <Label Text="{Binding UserName, StringFormat='Welcome, {0}'}" 
                       FontSize="32" 
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label Text="Ready for today's reflection?" 
                       FontSize="16" 
                       TextColor="{StaticResource Neutral400}" />
            </VerticalStackLayout>

            <!-- Stats Grid -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                <!-- Current Streak Card (Teal) -->
                <Border Grid.Column="0" 
                        BackgroundColor="#0D9488"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="25">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
                        <Label Text="CURRENT STREAK" 
                               FontSize="10" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               Opacity="0.8"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding CurrentStreak}" 
                               FontSize="48" 
                               FontAttributes="Bold" 
                               TextColor="White"
                               HorizontalOptions="Center"/>
                        <Label Text="DAYS" 
                               FontSize="10" 
                               TextColor="White" 
                               Opacity="0.8"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Total Entries Card (Dark Glass) -->
                <Border Grid.Column="1" 
                        BackgroundColor="#1E293B"
                        StrokeThickness="1"
                        Stroke="#334155"
                        StrokeShape="RoundRectangle 16"
                        Padding="25">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
                        <Label Text="TOTAL ENTRIES" 
                               FontSize="10" 
                               FontAttributes="Bold" 
                               TextColor="{StaticResource Neutral400}" 
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding TotalEntries}" 
                               FontSize="48" 
                               FontAttributes="Bold" 
                               TextColor="White"
                               HorizontalOptions="Center"/>
                        <Label Text="RECORDS" 
                               FontSize="10" 
                               TextColor="{StaticResource Neutral400}" 
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Dominant Mood Card -->
            <Border BackgroundColor="#1E293B"
                    StrokeThickness="1"
                    Stroke="#334155"
                    StrokeShape="RoundRectangle 16"
                    Padding="25">
                <VerticalStackLayout Spacing="10">
                    <Label Text="DOMINANT MOOD" 
                           FontSize="10" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Neutral400}" />
                    <Label Text="{Binding MostFrequentMood}" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="#818CF8" />
                </VerticalStackLayout>
            </Border>

            <!-- Weekly Activity Section -->
            <VerticalStackLayout Spacing="20">
                <Label Text="Weekly Activity" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="White" />
                
                <Border BackgroundColor="#0F172A"
                        StrokeThickness="1"
                        Stroke="#1E293B"
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        HeightRequest="350">
                    <lvc:CartesianChart Series="{Binding WeeklySeries}" 
                                       XAxes="{Binding XAxes}"
                                       VerticalOptions="Fill" />
                </Border>
            </VerticalStackLayout>

            <!-- Bottom Spacer -->
            <BoxView HeightRequest="50" Color="Transparent"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
