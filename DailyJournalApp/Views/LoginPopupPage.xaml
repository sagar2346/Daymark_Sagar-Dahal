<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DailyJournalApp.ViewModels"
             x:Class="DailyJournalApp.Views.LoginPopupPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral950}}">

    <Grid>
        <Border VerticalOptions="Center" 
                HorizontalOptions="Center" 
                WidthRequest="450" 
                Padding="40"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Offset="0,10" Radius="30" Opacity="0.1"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="30">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="Welcome Back" 
                           Style="{StaticResource Headline}" 
                           HorizontalOptions="Center"/>
                    <Label Text="Unlock your secure personal journal" 
                           TextColor="{StaticResource Neutral500}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Secure PIN" 
                           FontSize="12" 
                           TextColor="{StaticResource Neutral600}"
                           Margin="5,0"/>
                    <Entry Text="{Binding Pin}"
                           IsPassword="True"
                           Keyboard="Numeric"
                           Placeholder="••••"
                           HorizontalTextAlignment="Center"
                           FontSize="24"/>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Danger}"
                       HorizontalOptions="Center"
                       HeightRequest="20"/>

                <Button Text="Unlock Journal"
                        Command="{Binding LoginCommand}"
                        FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
