<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DailyJournalApp.ViewModels"
             xmlns:model="clr-namespace:DailyJournalApp.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DailyJournalApp.Views.JournalPage"
             Title="{Binding Title}"
             x:DataType="vm:JournalViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Delete" Command="{Binding DeleteCommand}" Order="Secondary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, *" Padding="30" RowSpacing="25">
        
        <!-- Top Bar: Date & Title -->
        <VerticalStackLayout Grid.Row="0" Spacing="20">
            <DatePicker Date="{Binding SelectedDate}" 
                        Format="D"
                        HorizontalOptions="Center"
                        FontSize="18"
                        FontAttributes="Bold">
                <DatePicker.Behaviors>
                    <toolkit:EventToCommandBehavior EventName="DateSelected" Command="{Binding DateChangedCommand}" />
                </DatePicker.Behaviors>
            </DatePicker>
            
            <Entry Placeholder="Journal Title" 
                   Text="{Binding CurrentEntry.Title}"
                   FontSize="22" 
                   FontAttributes="Bold"
                   PlaceholderColor="{StaticResource Neutral400}" />
            
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label Text="How are you feeling?" 
                       FontSize="14" 
                       FontAttributes="Bold"
                       TextColor="{StaticResource Neutral600}" 
                       VerticalOptions="Center"/>
                <Button Text="Clear" 
                        Command="{Binding ClearMoodCommand}"
                        Style="{StaticResource ButtonOutlineStyle}"
                        HeightRequest="30"
                        Padding="10,0"
                        FontSize="11"
                        IsVisible="{Binding SelectedMood, Converter={StaticResource IsNotNullConverter}}"
                        VerticalOptions="Center" />
            </HorizontalStackLayout>
            <CollectionView ItemsSource="{Binding Moods}" 
                             SelectionMode="Single"
                             SelectedItem="{Binding SelectedMood}"
                             HeightRequest="70">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Mood">
                        <Border StrokeShape="RoundRectangle 30"
                                Padding="15,8"
                                StrokeThickness="0">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral800}}" />
                                            <Setter TargetName="MoodName" Property="Label.TextColor" Value="{StaticResource Neutral600}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter TargetName="MoodName" Property="Label.TextColor" Value="{StaticResource White}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="{Binding Emoji}" 
                                       FontSize="28" 
                                       VerticalOptions="Center" />
                                <Label x:Name="MoodName" 
                                       Text="{Binding Name}" 
                                       VerticalOptions="Center" 
                                       FontAttributes="Bold" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- Editor Area (Split) -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="25">
            <!-- Edit -->
            <Border Grid.Column="0" Padding="15">
                <Editor Placeholder="Write your thoughts..." 
                        Text="{Binding MarkdownText}"
                        VerticalOptions="Fill"
                        FontSize="16" />
            </Border>
            
            <!-- Preview -->
            <Border Grid.Column="1" Padding="20">
                <ScrollView>
                    <Label Text="{Binding HtmlPreview}" 
                           TextType="Html" 
                           VerticalOptions="Fill"
                           FontSize="16" />
                </ScrollView>
            </Border>
        </Grid>

        <!-- Save Button -->
        <Button Grid.Row="1" 
                Text="Save Reflection" 
                Command="{Binding SaveCommand}"
                FontAttributes="Bold"
                FontSize="16"
                HorizontalOptions="End"
                WidthRequest="200"
                IsVisible="{Binding UserIsAuthenticated}" />
        

    </Grid>
</ContentPage>
