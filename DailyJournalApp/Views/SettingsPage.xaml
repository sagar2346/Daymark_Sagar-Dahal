<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DailyJournalApp.ViewModels"
             x:Class="DailyJournalApp.Views.SettingsPage"
             Title="{Binding Title}"
             x:Name="this"
             x:DataType="vm:SettingsViewModel">
    <ScrollView>
        <VerticalStackLayout Spacing="30" Padding="30">
            <VerticalStackLayout Spacing="5">
                <Label Text="Settings" Style="{StaticResource Headline}" />
                <Label Text="Configure your experience and preferences" Style="{StaticResource SubHeadline}" />
            </VerticalStackLayout>

            <!-- Profile Section -->
            <Border Padding="25" IsVisible="{Binding UserIsAuthenticated}">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="20">
                    <Border Grid.Column="0" WidthRequest="60" HeightRequest="60" StrokeThickness="0" BackgroundColor="{StaticResource Primary}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30"/>
                        </Border.StrokeShape>
                        <Label Text="User" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontAttributes="Bold"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding CurrentUserName}" FontSize="20" FontAttributes="Bold" />
                        <Label Text="Personal Profile" TextColor="{StaticResource Neutral500}" FontSize="12" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2" 
                            Text="Logout" 
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource DangerButton}"
                            HeightRequest="40"
                            Padding="20,0"
                            VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Guest Mode Invitation -->
            <Border Padding="25" IsVisible="{Binding UserIsAuthenticated, Converter={StaticResource InvertedBoolConverter}}" BackgroundColor="{StaticResource Neutral100}">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Personalize Your Experience" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Log in to set a security PIN and manage your profile." TextColor="{StaticResource Neutral600}" FontSize="14" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Login" Command="{Binding LoginCommand}" Style="{StaticResource ButtonOutlineStyle}" HeightRequest="40" Padding="20,0" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Appearance Section -->
            <Border Padding="25">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Spacing="5" Grid.Column="0">
                        <Label Text="Appearance" FontSize="18" FontAttributes="Bold" />
                        <Label Text="Switch between light and dark visual themes" 
                               TextColor="{StaticResource Neutral500}" 
                               FontSize="14" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="10">
                        <Label Text="Dark Mode" VerticalOptions="Center" FontSize="14" TextColor="{StaticResource Neutral600}"/>
                        <Switch IsToggled="{Binding IsDarkMode}" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- Data Management Section -->
            <Border Padding="25">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Data Management" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Export your entire journal history to a professional PDF document." 
                           TextColor="{StaticResource Neutral500}" 
                           FontSize="14" />
                    <Button Text="Generate PDF Export" 
                            Command="{Binding ExportDataCommand}" 
                            IsEnabled="{Binding IsNotBusy}"
                            HorizontalOptions="Start"
                            WidthRequest="220" />
                </VerticalStackLayout>
            </Border>

            <!-- Security Section -->
            <Border Padding="25">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Security Settings" FontSize="18" FontAttributes="Bold" />
                    
                    <VerticalStackLayout Spacing="15" IsVisible="{Binding UserIsAuthenticated}">
                        <!-- Password Update -->
                        <Label Text="Update Login Password" 
                               TextColor="{StaticResource Neutral600}" 
                               FontAttributes="Bold"
                               FontSize="14" />
                        
                        <Entry Placeholder="Enter New Password" 
                               Text="{Binding NewPassword}" 
                               IsPassword="True" />

                        <Entry Placeholder="Confirm New Password" 
                               Text="{Binding ConfirmNewPassword}" 
                               IsPassword="True" />

                        <Button Text="Update Password" 
                                Command="{Binding UpdatePasswordCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                HorizontalOptions="Start"
                                WidthRequest="180" />
                    </VerticalStackLayout>

                    <Label Text="Please login to manage security settings." 
                           IsVisible="{Binding UserIsAuthenticated, Converter={StaticResource InvertedBoolConverter}}"
                           TextColor="{StaticResource Neutral500}"
                           HorizontalOptions="Center"
                           Margin="0,10" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
