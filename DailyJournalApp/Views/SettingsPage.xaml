<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DailyJournalApp.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DailyJournalApp.Views.SettingsPage"
             Title="{Binding Title}"
             x:Name="this"
             x:DataType="vm:SettingsViewModel">
    <ScrollView Background="{StaticResource PageBackgroundBrush}">
        <VerticalStackLayout Spacing="25" Padding="25">
            <VerticalStackLayout Spacing="5">
                <Label Text="Settings" Style="{StaticResource Headline}" />
                <Label Text="Configure your experience and preferences" Style="{StaticResource SubHeadline}" />
            </VerticalStackLayout>

            <!-- Profile Card -->
            <Border Style="{StaticResource GlassCard}" Padding="20">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                    <Border Grid.Column="0" 
                            WidthRequest="60" 
                            HeightRequest="60" 
                            StrokeShape="RoundRectangle 30"
                            BackgroundColor="{StaticResource Secondary}"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Label Text="User" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" 
                               TextColor="White" 
                               FontAttributes="Bold"
                               FontSize="14"/>
                    </Border>
                    
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding UserName}" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Label Text="{Binding UserProfileType}" 
                               FontSize="12" 
                               TextColor="{StaticResource TextColorSecondary}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2" 
                            Text="Logout" 
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource DangerButton}"
                            HeightRequest="40"
                            FontSize="13"
                            Padding="20,0"
                            VerticalOptions="Center"
                            CornerRadius="8"/>
                </Grid>
            </Border>

            <!-- Appearance Section -->
            <Border Style="{StaticResource GlassCard}" Padding="20">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Spacing="5" Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Appearance" Style="{StaticResource SectionHeader}" Margin="0"/>
                        <Label Text="Switch between light and dark visual themes" 
                               TextColor="{StaticResource TextColorSecondary}" 
                               FontSize="12" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="10">
                        <Label Text="Dark Mode" 
                               VerticalOptions="Center" 
                               FontSize="12" 
                               TextColor="{StaticResource TextColorPrimary}"/>
                        <Switch IsToggled="{Binding IsDarkMode}" OnColor="{StaticResource Primary}" ThumbColor="{StaticResource White}"/>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- Data Management Section -->
            <Border Style="{StaticResource GlassCard}" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Data Management" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <Label Text="Export your entire journal history to a professional PDF document." 
                           TextColor="{StaticResource TextColorSecondary}" 
                           FontSize="12" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="From" 
                                   FontSize="12" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource TextColorPrimary}" />
                            <Border StrokeShape="RoundRectangle 8" 
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral900}}" 
                                    StrokeThickness="0" 
                                    Padding="10,0"
                                    HeightRequest="44">
                                <DatePicker Date="{Binding ExportStartDate}" 
                                            Format="MMM dd, yyyy" 
                                            TextColor="{StaticResource TextColorPrimary}" 
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="To" 
                                   FontSize="12" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource TextColorPrimary}" />
                            <Border StrokeShape="RoundRectangle 8" 
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral900}}" 
                                    StrokeThickness="0" 
                                    Padding="10,0"
                                    HeightRequest="44">
                                <DatePicker Date="{Binding ExportEndDate}" 
                                            Format="MMM dd, yyyy" 
                                            TextColor="{StaticResource TextColorPrimary}" 
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    
                    <Button Text="Generate PDF Export" 
                            Command="{Binding ExportDataCommand}" 
                            IsEnabled="{Binding IsNotBusy}"
                            HorizontalOptions="Start"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="White"
                            HeightRequest="44"
                            FontSize="13"
                            Padding="25,0"
                            CornerRadius="8"
                            Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Border>

            <!-- Security Settings Section -->
            <Border Style="{StaticResource GlassCard}" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Security Settings" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <Label Text="Update Login Password" 
                           TextColor="{StaticResource TextColorSecondary}" 
                           FontSize="12" />
                    
                    <Border StrokeShape="RoundRectangle 8" 
                            BackgroundColor="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral900}}" 
                            StrokeThickness="0" 
                            Padding="15,0"
                            HeightRequest="48">
                        <Entry Placeholder="Enter New Password" 
                               Text="{Binding NewPassword}"
                               IsPassword="True"
                               TextColor="{StaticResource TextColorPrimary}"
                               PlaceholderColor="{StaticResource Neutral500}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"/>
                    </Border>

                    <Border StrokeShape="RoundRectangle 8" 
                            BackgroundColor="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral900}}" 
                            StrokeThickness="0" 
                            Padding="15,0"
                            HeightRequest="48">
                        <Entry Placeholder="Confirm New Password" 
                               Text="{Binding ConfirmPassword}"
                               IsPassword="True"
                               TextColor="{StaticResource TextColorPrimary}"
                               PlaceholderColor="{StaticResource Neutral500}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"/>
                    </Border>

                    <Button Text="Update Password" 
                            Command="{Binding ChangePasswordCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="44"
                            FontSize="13"
                            HorizontalOptions="Start"
                            Padding="25,0"
                            CornerRadius="8"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Premium Desktop Edition v1.0.1" 
                   HorizontalOptions="Center" 
                   FontSize="10" 
                   TextColor="{StaticResource Neutral500}" 
                   Margin="0,10,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
