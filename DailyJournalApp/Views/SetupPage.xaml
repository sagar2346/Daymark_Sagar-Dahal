<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DailyJournalApp.ViewModels"
             x:Class="DailyJournalApp.Views.SetupPage"
             x:DataType="vm:SetupViewModel"
             Title="{Binding Title}">

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral950}}">
        <Border VerticalOptions="Center" 
                HorizontalOptions="Center" 
                WidthRequest="450" 
                Padding="40"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Offset="0,10" Radius="30" Opacity="0.1"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="30">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="Welcome to Daily Journal" 
                           Style="{StaticResource Headline}" 
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Begin your journey of mindful reflection" 
                           TextColor="{StaticResource Neutral500}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="20">
                    <Label Text="Create Your Profile" 
                           FontSize="14" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource Neutral700}"
                           HorizontalOptions="Center"/>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Your Name" 
                               FontSize="12" 
                               TextColor="{StaticResource Neutral600}"
                               Margin="5,0"/>
                        <Entry Text="{Binding Username}"
                               Placeholder="Enter your name"
                               FontSize="16"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Password" 
                               FontSize="12" 
                               TextColor="{StaticResource Neutral600}"
                               Margin="5,0"/>
                        <Entry Text="{Binding Password}"
                               IsPassword="True"
                               Placeholder="At least 6 characters"
                               FontSize="16"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Confirm Password" 
                               FontSize="12" 
                               TextColor="{StaticResource Neutral600}"
                               Margin="5,0"/>
                        <Entry Text="{Binding ConfirmPassword}"
                               IsPassword="True"
                               Placeholder="Re-enter password"
                               FontSize="16"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Danger}"
                       HorizontalOptions="Center"
                       HeightRequest="20"/>

                <Button Text="Create Account"
                        Command="{Binding SignupCommand}"
                        FontAttributes="Bold"
                        HeightRequest="55"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
