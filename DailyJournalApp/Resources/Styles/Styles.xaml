<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- TYPOGRAPHY -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Neutral900}, Dark={StaticResource White}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Neutral900}, Dark={StaticResource White}}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>

    <Style TargetType="Label" x:Key="SubHeadline">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Neutral500}, Dark={StaticResource Neutral400}}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <Style TargetType="Label" x:Key="SectionHeader">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Neutral900}, Dark={StaticResource White}}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="Margin" Value="0,20,0,10" />
    </Style>

    <!-- PREMIUM CARDS -->
    <Style TargetType="Border" x:Key="GlassCard">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PureWhite}, Dark={StaticResource GlassSurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral800}}" />
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 24"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Shadow">
            <Shadow Brush="{AppThemeBinding Light={StaticResource Neutral300}, Dark={StaticResource Black}}" 
                    Offset="0,8" Radius="20" Opacity="0.15"/>
        </Setter>
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Neutral200}, Dark={StaticResource Neutral700}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceColorLight}, Dark={StaticResource SurfaceColorDark}}" />
    </Style>

    <!-- BUTTONS -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="24,14"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="10" Opacity="0.4"/>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="24,14"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="10" Opacity="0.4"/>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="GhostButton">
         <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Neutral700}, Dark={StaticResource Neutral300}}" />
         <Setter Property="BackgroundColor" Value="Transparent" />
         <Setter Property="Shadow" Value="{x:Null}"/>
         <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style TargetType="Button" x:Key="DangerButton">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="24,14"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource Danger}" Offset="0,4" Radius="10" Opacity="0.4"/>
        </Setter>
    </Style>

    <!-- INPUTS -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Neutral900}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Neutral50}, Dark={StaticResource Neutral900}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="15" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Neutral400}" />
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Neutral900}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Neutral50}, Dark={StaticResource Neutral900}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="15" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Neutral400}" />
        <Setter Property="MinimumHeightRequest" Value="120"/>
    </Style>

</ResourceDictionary>
