<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Modern Professional Palette -->
    <!-- Primary Brand -->
    <Color x:Key="Primary">#6366F1</Color>
    <Color x:Key="PrimaryDark">#4338CA</Color>
    <Color x:Key="PrimaryLight">#818CF8</Color>
    <Color x:Key="PrimaryTransparent">#1A6366F1</Color>
    
    <!-- Secondary / Accent -->
    <Color x:Key="Secondary">#0D9488</Color>
    <Color x:Key="SecondaryDark">#0F766E</Color>
    <Color x:Key="SecondaryLight">#2DD4BF</Color>

    <!-- Deep Space Dark Mode Backgrounds -->
    <Color x:Key="MidnightBlue">#0F172A</Color>
    <Color x:Key="DeepSpace">#020617</Color>
    <Color x:Key="GlassSurfaceDark">#1E293B</Color>
    
    <!-- Crisp Light Mode Backgrounds -->
    <Color x:Key="CloudWhite">#F8FAFC</Color>
    <Color x:Key="PureWhite">#FFFFFF</Color>
    <Color x:Key="GlassSurfaceLight">#FFFFFF</Color>

    <!-- Neutrals -->
    <Color x:Key="Neutral50">#F8FAFC</Color>
    <Color x:Key="Neutral100">#F1F5F9</Color>
    <Color x:Key="Neutral200">#E2E8F0</Color>
    <Color x:Key="Neutral300">#CBD5E1</Color>
    <Color x:Key="Neutral400">#94A3B8</Color>
    <Color x:Key="Neutral500">#64748B</Color>
    <Color x:Key="Neutral600">#475569</Color>
    <Color x:Key="Neutral700">#334155</Color>
    <Color x:Key="Neutral800">#1E293B</Color>
    <Color x:Key="Neutral900">#0F172A</Color>
    
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- UI Semantic Surface Colors -->
    <Color x:Key="SurfaceColorLight">#FFFFFF</Color>
    <Color x:Key="SurfaceColorDark">#1E293B</Color>
    
    <Color x:Key="SurfaceColor">#FFFFFF</Color> <!-- Local fallback -->
    
    <!-- Text Colors -->
    <Color x:Key="TextPrimaryLight">#0F172A</Color>
    <Color x:Key="TextPrimaryDark">#F1F5F9</Color>
    <Color x:Key="TextSecondaryLight">#475569</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>

    <Color x:Key="TextColorPrimary">#0F172A</Color> <!-- Fallback -->
    <Color x:Key="TextColorSecondary">#475569</Color> <!-- Fallback -->

    <!-- Semantic -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Danger">#EF4444</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PageBackgroundBrush">
        <SolidColorBrush.Color>
            <AppThemeBinding Light="{StaticResource CloudWhite}" Dark="{StaticResource DeepSpace}" />
        </SolidColorBrush.Color>
    </SolidColorBrush>
    
    <!-- Gradients -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
        <GradientStop Color="{StaticResource PrimaryDark}" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>