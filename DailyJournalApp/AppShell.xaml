<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DailyJournalApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DailyJournalApp"
    xmlns:views="clr-namespace:DailyJournalApp.Views"
    Title="Daily Journal"
    FlyoutBehavior="Flyout">

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Primary}}" HeightRequest="150" Padding="20">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="Daily Journal" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                <Label Text="Premium Desktop Edition" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Neutral400}}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Entry Point -->
    <ShellItem FlyoutItem.IsVisible="False">
        <ShellContent Route="LoadingPage" ContentTemplate="{DataTemplate views:LoadingPage}" />
    </ShellItem>

    <!-- Main Navigation -->
    <ShellItem Route="HomePage">
        <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
    </ShellItem>

    <FlyoutItem Title="Dashboard" Shell.FlyoutBehavior="Flyout">
        <ShellContent Route="DashboardPage" ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Daily Entry" Shell.FlyoutBehavior="Flyout">
        <ShellContent Route="JournalPage" ContentTemplate="{DataTemplate views:JournalPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Timeline" Shell.FlyoutBehavior="Flyout">
        <ShellContent Route="TimelinePage" ContentTemplate="{DataTemplate views:TimelinePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Analytics" Shell.FlyoutBehavior="Flyout">
        <ShellContent Route="AnalyticsPage" ContentTemplate="{DataTemplate views:AnalyticsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Settings" Shell.FlyoutBehavior="Flyout">
        <ShellContent Route="SettingsPage" ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

    <!-- Auth Pages will be registered in code-behind via Routing.RegisterRoute -->
    <!--
    <ShellItem Route="primary_login" FlyoutItem.IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" />
    </ShellItem>
    <ShellItem Route="setup_entry" FlyoutItem.IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:SetupPage}" />
    </ShellItem>
    -->

    <MenuItem Text="Logout" 
              Clicked="OnLogoutClicked">
    </MenuItem>

</Shell>
