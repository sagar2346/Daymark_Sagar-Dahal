<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DailyJournalApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DailyJournalApp"
    xmlns:views="clr-namespace:DailyJournalApp.Views"
    Title="Daily Journal"
    FlyoutBehavior="Flyout">

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Primary}}" 
              HeightRequest="150" 
              Padding="20"
              RowDefinitions="*, Auto">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="Daily Journal" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            </VerticalStackLayout>
            <Label Grid.Row="1" 
                   Text="Premium Desktop Edition v1.0.1 [AUTHENTICATION ENFORCED]" 
                   TextColor="{StaticResource Neutral400}" 
                   FontSize="12" 
                   HorizontalOptions="Center" 
                   Margin="0,20,0,0" />
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Hidden Root Pages (Login is now First to ensure it opens first) -->
    <ShellItem x:Name="loginItem" Route="login" FlyoutItem.IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" />
    </ShellItem>

    <!-- Main Navigation Items -->
    <FlyoutItem Title="Dashboard" Route="dashboard">
        <ShellContent Route="DashboardPage" ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Daily Entry">
        <ShellContent Route="JournalPage" ContentTemplate="{DataTemplate views:JournalPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Timeline">
        <ShellContent Route="TimelinePage" ContentTemplate="{DataTemplate views:TimelinePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Analytics">
        <ShellContent Route="AnalyticsPage" ContentTemplate="{DataTemplate views:AnalyticsPage}" />
    </FlyoutItem>



    <FlyoutItem Title="Settings">
        <ShellContent Route="SettingsPage" ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

    <MenuItem Text="Logout" 
              Clicked="OnLogoutClicked">
    </MenuItem>

</Shell>
